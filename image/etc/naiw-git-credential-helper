#!/usr/bin/env bash
# /usr/local/bin/naiw-git-credential-helper
# Implements the git credential helper get/store/erase protocol (we only handle get).
# Sanitization rationale (Issue 1):
#   - missing OR empty secret file -> exit 0 with no output (fall through to next helper)
#   - strip CR/LF from token: a stray newline would inject a second key=value line into
#     git's credential protocol output, which the parser would accept as a new field
set -euo pipefail
op="${1:-get}"
[[ "$op" != "get" ]] && exit 0
secret=/run/secrets/github_token
[[ -s "$secret" ]] || exit 0
# Strip CR/LF/tab/space — a whitespace-only token (e.g., "   \n") would
# otherwise be sent as a literal blank password and produce a confusing
# "Bad credentials" from GitHub instead of a clean fall-through.
token=$(tr -d '\r\n\t ' < "$secret")
[[ -n "$token" ]] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$token"
